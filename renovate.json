{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "Rust Minor & Patch",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "labels": [
        "rust",
        "dependencies"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
